#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
prefix="${1:-full-20261006}"
while true; do
  if .venv/bin/python -c 'import json, pathlib, sys; p=sorted(pathlib.Path("runs").glob(sys.argv[1]+"-gpu*/status.json")); sys.exit(0 if len(p)==4 and all(json.loads(x.read_text())["status"]=="completed" for x in p) else 1)' "$prefix"; then
    bin/merge-shards
    bin/reconstruct build --input data/labels.jsonl --output artifacts/movie_embeddings.npz
    bin/reconstruct benchmark --artifact artifacts/movie_embeddings.npz --queries 200
    exit 0
  fi
  sleep 30
done
