#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

label_gpu="${MOVIE_LABEL_CUDA:-0}"

bin/train-embeddings --min-ratings 500
bin/backfill-artwork
bin/seed-movielens-labels

while true; do
  movie_count="$(.venv/bin/python -c 'import json; from pathlib import Path; print(sum(1 for line in Path("data/processed/movie_catalog.jsonl").open() if line.strip()))')"
  label_count="$(.venv/bin/python -c 'import json; from pathlib import Path; p=Path("data/processed/movie_lens_labels.jsonl"); ids=set();
if p.exists():
  for line in p.open():
    try: ids.add(int(json.loads(line)["movie"]["tmdb_id"]))
    except (KeyError, ValueError, TypeError, json.JSONDecodeError): pass
print(len(ids))')"
  if (( label_count >= movie_count )); then
    break
  fi
  before="$label_count"
  CUDA_VISIBLE_DEVICES="$label_gpu" bin/label-catalog \
    --backend transformers \
    --model Qwen/Qwen2.5-3B-Instruct \
    --input data/processed/movie_catalog.jsonl \
    --output data/processed/movie_lens_labels.jsonl
  after="$(.venv/bin/python -c 'import json; from pathlib import Path; p=Path("data/processed/movie_lens_labels.jsonl"); ids=set();
for line in p.open():
  try: ids.add(int(json.loads(line)["movie"]["tmdb_id"]))
  except (KeyError, ValueError, TypeError, json.JSONDecodeError): pass
print(len(ids))')"
  if (( after <= before )); then
    echo "Labeling made no progress ($after of $movie_count profiles). See the newest file under runs/." >&2
    exit 1
  fi
done

if [[ -f artifacts/movie_embeddings.npz && -f artifacts/movie_embeddings.metadata.json ]]; then
  prior_count="$(.venv/bin/python -c 'import json; from pathlib import Path; print(len(json.loads(Path("artifacts/movie_embeddings.metadata.json").read_text())))')"
  if (( prior_count != movie_count )) && [[ ! -e artifacts/movie_embeddings_tmdb_8298.npz ]]; then
    cp artifacts/movie_embeddings.npz artifacts/movie_embeddings_tmdb_8298.npz
    cp artifacts/movie_embeddings.metadata.json artifacts/movie_embeddings_tmdb_8298.metadata.json
  fi
fi

bin/reconstruct build \
  --input data/processed/movie_lens_labels.jsonl \
  --output artifacts/movie_embeddings.npz
bin/evaluate --queries 200 --k 10 5 20
bin/reconstruct benchmark --artifact artifacts/movie_embeddings.npz

echo "Finished the MovieLens movie recommender."
echo "Open reports/evaluation.json and reports/reconstruction_benchmark.json for the results."
echo "For the HTTP load test, start bin/web and then run bin/loadtest."
